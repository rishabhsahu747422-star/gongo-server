# ==============================================================================
# GONGO Unified Backend — Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env and provide your environment-specific credentials.
# In production, set these variables via your container platform or hosting secret manager.
# NEVER commit real credentials or private keys to source control.
# ==============================================================================

# ── Application Runtime ───────────────────────────────────────────────────────
NODE_ENV=production
PORT=8080
HOST=0.0.0.0
API_VERSION=v1
LOG_LEVEL=info

# ── Reverse Proxy & Security Headers ──────────────────────────────────────────
# Set to '1' for single-hop proxy (Render, Railway, AWS ALB, Cloudflare),
# 'loopback' for local nginx, or explicit CIDR. NEVER use 'true' in production.
TRUST_PROXY=1

# ── CORS Allowlist ────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins (e.g. Admin portal, web clients).
# Wildcards ('*') are strictly disallowed in production.
CORS_ORIGINS=https://admin.gongo.in,https://app.gongo.in

# ── Background Workers ────────────────────────────────────────────────────────
# Enables no-show auto-cancellation, payment timeouts, and outbox event publishing.
ENABLE_WORKERS=true

# ── PostgreSQL Database Connection ────────────────────────────────────────────
# PostgreSQL connection string: postgresql://<user>:<password>@<host>:<port>/<database>
# When using Supabase Session Pooler (port 5432, pool size limit 15), keep DB_POOL_MIN=0 and DB_POOL_MAX=3.
DATABASE_URL=postgresql://postgres.projectref:password@aws-0-region.pooler.supabase.com:5432/postgres
DB_POOL_MIN=0
DB_POOL_MAX=3
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
DB_SSL=true

# ── Redis Cache & State Store ─────────────────────────────────────────────────
# Used for OTP validation state, rate limiting, and session revocation.
REDIS_URL=rediss://default:password@redis-host:6379
USE_REDIS_MOCK=false

# ── Supabase (Database, Auth & Storage) ───────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...placeholder-public-anon-key...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...placeholder-backend-service-role-key...

# Storage Buckets (Separation of Public vs Private)
PUBLIC_STORAGE_BUCKET=gongo-uploads
PRIVATE_STORAGE_BUCKET=gongo-partner-documents
CUSTOMER_STORAGE_BUCKET=gongo-customers
SUPABASE_STORAGE_BUCKET=gongo-uploads
SUPABASE_STORAGE_PRESIGN_UPLOAD_EXPIRES_SECONDS=900
SUPABASE_STORAGE_PRESIGN_DOWNLOAD_EXPIRES_SECONDS=3600

# ── SMS Gateway (Renflair / MSG91) ────────────────────────────────────────────
RENFLAIR_API_KEY=your_renflair_api_key_here
RENFLAIR_BASE_URL=https://sms.renflair.in/V1.php

# MSG91 (Optional / Secondary Provider)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=GONGOI

# ── Authentication & OTP Settings ─────────────────────────────────────────────
AUTH_OTP_EXPIRY_SECONDS=300
AUTH_OTP_RESEND_SECONDS=30
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_PHONE_MAX=5
AUTH_RATE_LIMIT_IP_MAX=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=3600

# Development Auth Bypass (Strictly false in production)
CUSTOMER_DEV_AUTH_ENABLED=false
PARTNER_DEV_AUTH_ENABLED=false
PARTNER_DEV_LOGIN_ENABLED=false
ADMIN_DEV_AUTH_ENABLED=false

# ── Cashfree Payment Gateway & Payouts ────────────────────────────────────────
CASHFREE_APP_ID=your_cashfree_production_app_id
CASHFREE_SECRET_KEY=your_cashfree_production_secret_key
CASHFREE_ENV=PRODUCTION
CASHFREE_API_VERSION=2025-01-01
CASHFREE_PAYOUT_API_VERSION=2024-01-01
BACKEND_PUBLIC_URL=https://api.gongo.in
CASHFREE_RETURN_URL=https://api.gongo.in/api/v1/payments/return?order_id={order_id}
CASHFREE_NOTIFY_URL=https://api.gongo.in/api/v1/payments/webhook/cashfree
DEV_DUMMY_PAYMENT_ENABLED=false

# ── Razorpay (Legacy / Alternate Payment Provider) ────────────────────────────
RAZORPAY_KEY_ID=rzp_live_placeholder
RAZORPAY_KEY_SECRET=rzp_live_secret_placeholder

# ── DigiLocker & Aadhaar Verification ─────────────────────────────────────────
SANDBOX_API_KEY=your_sandbox_api_key
SANDBOX_API_SECRET=your_sandbox_api_secret
SANDBOX_API_VERSION=1.0.0

DIGILOCKER_CLIENT_ID=your_digilocker_client_id
DIGILOCKER_CLIENT_SECRET=your_digilocker_client_secret
DIGILOCKER_ENV=PRODUCTION
DIGILOCKER_API_BASE_URL=https://api.digitallocker.gov.in
DIGILOCKER_REDIRECT_URI=https://api.gongo.in/api/v1/customers/aadhaar/callback

# Keyed HMAC Secret for Aadhaar Identity Fingerprint Matching (Prevent Duplicates)
# MUST be a strong, high-entropy 256-bit server-side secret. NEVER expose to frontend.
AADHAAR_HMAC_SECRET=your_dedicated_secure_aadhaar_hmac_secret_here
AADHAAR_XML_RETENTION_ENABLED=true
AADHAAR_STORAGE_BUCKET=gongo-customers

# ── Google OAuth (Admin Portal Authentication) ────────────────────────────────
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_CALLBACK_URL=https://api.gongo.in/api/v1/admin/auth/google/callback
ADMIN_OAUTH_REDIRECT_URL=https://admin.gongo.in/auth/callback
GOOGLE_OAUTH_STATE_TTL_SECONDS=600
ADMIN_GOOGLE_REQUIRE_OTP=false

# ── Admin Session Lifecycle ───────────────────────────────────────────────────
ADMIN_SESSION_TTL_SECONDS=86400
ADMIN_MAX_ACTIVE_SESSIONS=5
ADMIN_LOGIN_MAX_FAILED_ATTEMPTS=5
ADMIN_LOGIN_LOCKOUT_SECONDS=900

# ── AWS S3 (Storage Fallback, if configured) ──────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=gongo-uploads
AWS_S3_PRESIGN_UPLOAD_EXPIRES_SECONDS=900
AWS_S3_PRESIGN_DOWNLOAD_EXPIRES_SECONDS=3600

# ── Location & Maps (Server-side geocoding only) ───────────────────────────────
GOOGLE_MAPS_API_KEY=
