# ==============================================================================
# GONGO Unified Backend — environment template
# Placeholder values only. Never commit real credentials.
# In production set these as platform environment variables (no .env file needed).
# [REQUIRED] = startup fails in production if missing/invalid.
# ==============================================================================

# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=production                 # [REQUIRED] must be exactly "production" — anything else enables dev shortcuts
PORT=8080                           # usually injected by the platform
HOST=0.0.0.0
LOG_LEVEL=info
TRUST_PROXY=1                       # hop count of the platform load balancer; never "true"
ENABLE_WORKERS=true                 # no-show auto-cancel + outbox workers (SKIP LOCKED, safe on many instances)
API_VERSION=v1

# ── CORS (browser origins only; native mobile apps send no Origin) ─────────────
# Set all three to the same list (each sub-app reads its own name). No wildcards.
CORS_ORIGINS=https://admin.example.com
CORS_ORIGIN=https://admin.example.com           # [REQUIRED] Customer
CORS_ALLOWED_ORIGINS=https://admin.example.com  # Partner, Admin

# ── PostgreSQL (Supabase) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres   # [REQUIRED]
DB_SSL=true
DB_POOL_MIN=1
DB_POOL_MAX=5                       # 3 sub-apps each open their own pool (3 x max per instance)
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=rediss://default:PASSWORD@HOST:6379   # [REQUIRED] sessions, OTP, rate limits
USE_REDIS_MOCK=false                # must be false in production

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co   # [REQUIRED]
SUPABASE_ANON_KEY=replace-me                    # [REQUIRED]
SUPABASE_SERVICE_ROLE_KEY=replace-me            # [REQUIRED] backend only, never ship to clients
SUPABASE_STORAGE_BUCKET=replace-me              # [REQUIRED]

# ── AWS S3 (Admin document storage) ───────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=replace-me                    # [REQUIRED]
AWS_SECRET_ACCESS_KEY=replace-me                # [REQUIRED]
AWS_S3_BUCKET=replace-me                        # [REQUIRED]
AWS_S3_PUBLIC=false                             # must be false in production

# ── Cashfree ──────────────────────────────────────────────────────────────────
CASHFREE_APP_ID=replace-me                      # [REQUIRED] real value (placeholder rejected)
CASHFREE_SECRET_KEY=replace-me                  # [REQUIRED] also verifies webhook signatures
CASHFREE_ENV=PRODUCTION                         # SANDBOX only for staging
CASHFREE_API_VERSION=2025-01-01
CASHFREE_RETURN_URL=https://app.example.com/bookings/{order_id}/payment-status

# ── Security ──────────────────────────────────────────────────────────────────
ENCRYPTION_KEY=replace-with-64-hex-chars        # [REQUIRED] Partner bank-detail encryption; `openssl rand -hex 32`

# ── OTP / SMS ─────────────────────────────────────────────────────────────────
RENFLAIR_API_KEY=replace-me
RENFLAIR_BASE_URL=https://sms.renflair.in/V1.php
AUTH_OTP_EXPIRY_SECONDS=300
AUTH_OTP_MAX_ATTEMPTS=3

# ── Google OAuth (Admin Portal) ──────────────────────────────────────────────
# All four variables are required to enable Google OAuth for administrators.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/admin/auth/google/callback
ADMIN_OAUTH_REDIRECT_URL=http://localhost:5173/login

# ── Optional integrations ─────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Development shortcuts — must stay false (startup fails in production if true) ──
CUSTOMER_DEV_AUTH_ENABLED=false
DEV_DUMMY_PAYMENT_ENABLED=false
PARTNER_DEV_AUTH_ENABLED=false
PARTNER_DEV_LOGIN_ENABLED=false
ADMIN_DEV_AUTH_ENABLED=false
