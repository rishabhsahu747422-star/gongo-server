# ==============================================================================
# GONGO ADMIN BACKEND — ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to .env for local development.
# In production, set these via environment secret management (e.g. AWS SSM / ECS).
# DO NOT COMMIT ACTUAL PRODUCTION SECRETS OR PRIVATE KEYS TO VERSION CONTROL.
# ==============================================================================

# ── 1. Application Configuration ─────────────────────────────────────────────
NODE_ENV=development
PORT=3002
API_PREFIX=/api/v1
LOG_LEVEL=info
TRUST_PROXY=loopback
ALLOW_DEV_DB_FALLBACK=false
ENABLE_OUTBOX_WORKER=true

# ── 2. CORS Configuration ────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Wildcards strictly forbidden in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# ── 3. PostgreSQL Database (Shared Canonical GONGO Database) ─────────────────
# The Admin Backend MUST connect to the same PostgreSQL database as Customer & Partner.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gongo_partner
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gongo_partner
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
DB_SSL=false

# ── 4. Redis Cache & Rate Limiting ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379
USE_REDIS_MOCK=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ── 4b. Admin Session Lifecycle ──────────────────────────────────────────────
ADMIN_SESSION_TTL_SECONDS=86400
ADMIN_MAX_ACTIVE_SESSIONS=5
ADMIN_SESSION_ACTIVITY_THROTTLE_SECONDS=60

# ── 4c. Admin Authentication ─────────────────────────────────────────────────
# Admin sign-in: email or mobile + password followed by mandatory SMS OTP delivery
# via the Renflair SMS Gateway to the verified administrator mobile number on file.
ADMIN_LOGIN_MAX_FAILED_ATTEMPTS=5
ADMIN_LOGIN_LOCKOUT_SECONDS=900
# One-time migration of admins whose password is still in Supabase Auth (bound to users.auth_id).
# Set to false once every admin has signed in (or been given a local password).
ADMIN_LEGACY_SUPABASE_PASSWORD_MIGRATION=true

# Renflair SMS Gateway Provider (Admin OTP delivery)
RENFLAIR_API_KEY=
RENFLAIR_BASE_URL=https://sms.renflair.in/V1.php
AUTH_OTP_EXPIRY_SECONDS=300
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
AUTH_OTP_MAX_ATTEMPTS=3

# Google OAuth (Authorization Code + PKCE). Leave ALL four empty to disable Google sign-in.
# GOOGLE_CALLBACK_URL must exactly match an Authorized redirect URI in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/admin/auth/google/callback
# Admin Portal page that receives #ticket=... / #linked=google / #error=... after Google sign-in
ADMIN_OAUTH_REDIRECT_URL=http://localhost:5173/login
GOOGLE_OAUTH_STATE_TTL_SECONDS=600

# Initial Super Admin password — DO NOT put it in this file. Pass it only to the seed command:
#   SUPER_ADMIN_INITIAL_PASSWORD='...' npm run db:seed:super-admin

# ── 5. Supabase (PostgreSQL, Storage) ────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=gongo-uploads

# ── 6. AWS S3 Storage Provider ───────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=gongo-admin-documents
AWS_S3_PUBLIC=false
AWS_S3_PRESIGN_UPLOAD_EXPIRES_SECONDS=900
AWS_S3_PRESIGN_DOWNLOAD_EXPIRES_SECONDS=300
AWS_S3_MAX_UPLOAD_SIZE_BYTES=10485760

# ── 7. Cashfree Payment Gateway ───────────────────────────────────────────────
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_ENV=SANDBOX
CASHFREE_API_VERSION=2023-08-01
