{
  "name": "gongo-unified-backend",
  "version": "1.0.0",
  "private": true,
  "description": "GONGO Unified Backend — Consolidated Customer, Partner, and Admin Marketplace Architecture",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest tests --runInBand --forceExit",
    "test:customer": "npm --prefix Customer test",
    "test:partner": "npm --prefix Partner test",
    "test:admin": "npm --prefix Admin test",
    "start:customer": "node Customer/src/server.js",
    "start:partner": "node Partner/src/server.js",
    "start:admin": "node Admin/src/server.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "@supabase/supabase-js": "^2.117.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "envalid": "^8.0.0",
    "express": "^4.19.2",
    "firebase-admin": "^14.4.0",
    "helmet": "^7.1.0",
    "http-graceful-shutdown": "^3.1.13",
    "ioredis": "^5.4.1",
    "morgan": "^1.10.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.12.0",
    "razorpay": "^2.9.4",
    "twilio": "^6.1.2",
    "uuid": "^9.0.1",
    "winston": "^3.14.1"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.1",
    "ioredis-mock": "^8.13.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "pg-mem": "^3.0.14",
    "supertest": "^7.0.0"
  }
}
