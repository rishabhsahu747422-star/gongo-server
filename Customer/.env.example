# ============================================================
# GONGO Customer Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_VERSION=v1

# Logging level: error | warn | info | http | debug
LOG_LEVEL=http

# ------------------------------------------------------------
# Trusted Proxy Configuration
# Controls Express 'trust proxy' setting for resolving real client IP.
# Values: false (direct), loopback (nginx on same host), 1 (single-hop ALB),
# or a CIDR range (e.g. 10.0.0.0/8). NEVER set to 'true' in production.
# ------------------------------------------------------------
TRUST_PROXY=false

# ------------------------------------------------------------
# CORS
# Comma-separated list of allowed origins.
# No wildcards in production.
# ------------------------------------------------------------
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------
# PostgreSQL
# Use a full connection string for simplicity.
# Format: postgresql://user:password@host:port/database
# ------------------------------------------------------------
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/gongo_dev

# Connection pool settings
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000
DB_SSL=false

# ------------------------------------------------------------
# Redis
# Used for OTP state, rate limiting, and session revocation.
# ------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------
# Firebase Admin SDK
# FIREBASE_PRIVATE_KEY must have literal \n characters for newlines.
# Wrap in double quotes if your shell requires it.
# ------------------------------------------------------------
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------
# MSG91 SMS Provider
# ------------------------------------------------------------
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_msg91_otp_template_id
MSG91_SENDER_ID=GONGOI

# ------------------------------------------------------------
# Authentication & Rate Limiting
# ------------------------------------------------------------
AUTH_OTP_EXPIRY_SECONDS=300
AUTH_OTP_RESEND_SECONDS=30
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_PHONE_MAX=5
AUTH_RATE_LIMIT_IP_MAX=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=3600

# ------------------------------------------------------------
# AWS S3
# Not implemented yet — required for startup validation only.
# ------------------------------------------------------------
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_S3_BUCKET=gongo-uploads-dev

# ------------------------------------------------------------
# Razorpay
# Not implemented yet — required for startup validation only.
# ------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ------------------------------------------------------------
# Cashfree Payment Gateway (Production / Sandbox)
# Set CASHFREE_ENV=production for live real payments, sandbox for testing
# ------------------------------------------------------------
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_ENV=production
CASHFREE_API_VERSION=2025-01-01
CASHFREE_RETURN_URL=https://app.gongo.in/bookings/{order_id}/payment-status

# ------------------------------------------------------------
# Google Maps API (Server-Side Geocoding)
# ------------------------------------------------------------
GOOGLE_MAPS_API_KEY=your_google_maps_server_api_key

